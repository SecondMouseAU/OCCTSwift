-void ChFi3d_StripeEdgeInter(const occ::handle<ChFiDS_Stripe>& theStripe1,
+//! Examines two stripes for an intersection between their curves of interference with faces.
+//! Throws StdFail_NotDone if the curves cross or overlap in part.
+//! @return true if the two stripes meet exactly: their curves of interference on a common face
+//! coincide over their whole length, so that the face between them has no width.
+bool ChFi3d_StripeEdgeInter(const occ::handle<ChFiDS_Stripe>& theStripe1,
                             const occ::handle<ChFiDS_Stripe>& theStripe2,
                             TopOpeBRepDS_DataStructure&       DStr,
                             const double                      tol2d);
 
+//! True if theInter, computed for theCurve1 and theCurve2, holds nothing but the contact of
+//! one end of each curve: the two curves touch and do not cross.
+bool ChFi3d_IsEndContact(const Geom2dInt_GInter&    theInter,
+                         const Geom2dAdaptor_Curve& theCurve1,
+                         const Geom2dAdaptor_Curve& theCurve2,
+                         const double               theTol2d);
+
 int ChFi3d_IndexOfSurfData(const TopoDS_Vertex&              V1,
                            const occ::handle<ChFiDS_Stripe>& CD,
                            int&                              sens);
