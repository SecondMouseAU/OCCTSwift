@@ -45,6 +47,17 @@ bool AffichageGraph = true;
 
 const double PIsur2 = 0.5 * M_PI;
 
+namespace
+{
+// reduces an angle to [0, 2PI) in one step; stepping a turn at a time never ends for an infinite
+// angle, nor for one so large that a turn is below its last digit
+double ReducedToTurn(const double theAngle)
+{
+  const double aReduced = std::fmod(theAngle, PIpPI);
+  return aReduced < 0.0 ? aReduced + PIpPI : aReduced;
+}
+} // namespace
