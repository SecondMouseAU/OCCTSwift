+      aBindOrder.Add(anIt.Value());
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(myAnalyse.NewFaces()); anIt.More();
+         anIt.Next())
+    {
+      aBindOrder.Add(anIt.Value());
+    }
+  }
