+//! Appends the point the path has reached: the last vertex of its last edge, or the vertex
+//! itself if the path already ended in one.
+static void PadPath(NCollection_Sequence<TopoDS_Shape>& thePath)
+{
+  TopoDS_Shape aVer = thePath.Last();
+  if (aVer.ShapeType() == TopAbs_EDGE)
+  {
+    aVer = TopExp::LastVertex(TopoDS::Edge(aVer), true);
+  }
+  thePath.Append(aVer);
+}
+
+//! Returns the 2d point of the end of the path element on the face: the end of the edge, or the
+//! parameters of the vertex if the element is a vertex.
+static bool EndPoint2d(const TopoDS_Edge&   theEdge,
+                       const TopoDS_Vertex& theVertex,
+                       const TopoDS_Face&   theFace,
+                       gp_Pnt2d&            thePnt)
+{
+  if (theEdge.IsNull())
+  {
+    for (TopExp_Explorer anExp(theFace, TopAbs_VERTEX); anExp.More(); anExp.Next())
+    {
+      if (anExp.Current().IsSame(theVertex))
+      {
+        thePnt = BRep_Tool::Parameters(theVertex, theFace);
+        return true;
+      }
+    }
+    return false;
+  }
+  double                    aFirst, aLast;
+  occ::handle<Geom2d_Curve> aPCurve = BRep_Tool::CurveOnSurface(theEdge, theFace, aFirst, aLast);
+  if (aPCurve.IsNull())
+  {
+    return false;
+  }
+  thePnt = aPCurve->Value((theEdge.Orientation() == TopAbs_FORWARD) ? aLast : aFirst);
+  return true;
+}
+
+//! Returns the edge of the 2d line on the surface between two vertices, or a null edge if the line
+//! does not exist or the vertices are not on it.
+static TopoDS_Edge MakeSectionEdge(const occ::handle<Geom2d_Line>&  theLine,
+                                   const occ::handle<Geom_Surface>& theSurf,
+                                   const TopoDS_Vertex&             theV1,
+                                   const TopoDS_Vertex&             theV2,
+                                   const double                     theLength)
+{
+  if (theLine.IsNull())
+  {
+    return TopoDS_Edge();
+  }
+  BRepLib_MakeEdge aMaker(theLine, theSurf, theV1, theV2, 0., theLength);
+  if (!aMaker.IsDone())
+  {
+    return TopoDS_Edge();
+  }
+  TopoDS_Edge anEdge = aMaker.Edge();
+  BRepLib::BuildCurve3d(anEdge);
+  return anEdge;
+}
+
