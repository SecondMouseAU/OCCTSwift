+
+namespace
+{
+//! True if the shape is valid, or becomes valid under the SameParameter pass callers apply next.
+bool isValidChamferResult(const TopoDS_Shape& theShape)
+{
+  if (BRepCheck_Analyzer(theShape).IsValid())
+  {
+    return true;
+  }
+  BRepBuilderAPI_Copy aCopy(theShape);
+  BRepLib::SameParameter(aCopy.Shape(), Precision::Confusion(), true);
+  return BRepCheck_Analyzer(aCopy.Shape()).IsValid();
+}
+} // namespace
 
 void BRepFilletAPI_MakeChamfer::Build(const Message_ProgressRange& /*theRange*/)
 {
   myBuilder.Compute();
-  if (myBuilder.IsDone())
+  // A result that is not a valid solid is a failure, as for BRepFilletAPI_MakeFillet.
+  if (myBuilder.IsDone() && isValidChamferResult(myBuilder.Shape()))
   {
     Done();
     myShape = myBuilder.Shape();
