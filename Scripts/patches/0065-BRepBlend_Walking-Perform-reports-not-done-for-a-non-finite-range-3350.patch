@@ -196,6 +197,12 @@
     line->Clear();
     doextremities = false;
   }
+  // A walk over a non-finite range is undefined: CorrectExtremityOnOneRst would project a NaN
+  // point onto a guide of infinite parameter range. Report not done, as for any failed walk.
+  if (!std::isfinite(Pdep) || !std::isfinite(Pmax) || !std::isfinite(Fleche))
