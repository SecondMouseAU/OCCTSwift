@@ -29,6 +29,8 @@
 #include <ChFiDS_StripeMap.hxx>
 #include <ChFiDS_ElSpine.hxx>
 #include <math_Vector.hxx>
+#include <TopoDS.hxx>
+#include <TopoDS_Face.hxx>
 #include <TopoDS_Shape.hxx>
 #include <Standard_Integer.hxx>
 #include <TopTools_ShapeMapHasher.hxx>
@@ -179,6 +181,14 @@ public:
   //! Returns the shape on which the fillets are computed.
   const TopoDS_Shape& InitialShape() const { return myShape; }
 
+  //! Returns the face on whose side the first distance of a chamfer on the edge is measured (the face
+  //! given to Add), or a null face if the edge is in no contour.
+  TopoDS_Face FirstFaceOf(const TopoDS_Edge& theEdge) const
+  {
+    const TopoDS_Shape* aFace = myEdgeFirstFace.Seek(theEdge);
+    return aFace != nullptr ? TopoDS::Face(*aFace) : TopoDS_Face();
+  }
+
   //! Returns the Builder of topologic operations.
   Standard_EXPORT occ::handle<TopOpeBRepBuild_HBuilder> Builder() const;
 
