+#include <BRepGProp.hxx>
+#include <BRepPrimAPI_MakePrism.hxx>
+#include <ChFiDS_ChamfMethod.hxx>
+#include <ChFiDS_ChamfSpine.hxx>
 #include <ChFiDS_Spine.hxx>
+#include <GProp_GProps.hxx>
+#include <NCollection_IndexedDataMap.hxx>
+#include <NCollection_IndexedMap.hxx>
+#include <Precision.hxx>
+#include <TopExp.hxx>
 #include <TopExp_Explorer.hxx>
+#include <TopoDS.hxx>
 #include <TopoDS_Edge.hxx>
 #include <TopoDS_Face.hxx>
 #include <TopoDS_Shape.hxx>
 #include <TopoDS_Vertex.hxx>
 #include <TopOpeBRepBuild_HBuilder.hxx>
 #include <TopOpeBRepDS_HDataStructure.hxx>
+#include <TopTools_ShapeMapHasher.hxx>
+#include <gp_Dir.hxx>
+#include <gp_Pnt.hxx>
+#include <gp_Vec.hxx>
+#include <Standard_Failure.hxx>
+
+//! What a chamfer distance that exceeds its face does. The kernel refused it before this change and the
+//! maintainer has not chosen what is right, so the three readings are all here and one is compiled:
+//!   0  decline (Build leaves IsDone() false, as before)
+//!   1  pivot: a face that runs out ends at its far edge, the cut line passes through that edge and keeps the
+//!      distance that fits, the analogue of what BRepFilletAPI_MakeFillet does for a fillet past its face
+//!   2  half-space: the cut is the plane through the two distances, extended past the face and clipped by the solid
+#ifndef BRepFilletAPI_CHAMFER_RUNOUT
+  #define BRepFilletAPI_CHAMFER_RUNOUT 0
+#endif
+
+namespace
+{
+typedef NCollection_IndexedDataMap<TopoDS_Shape,
+                                   NCollection_List<TopoDS_Shape>,
+                                   TopTools_ShapeMapHasher>
+  ChamferEdgeFaceMap;
+
+double chamferVolumeOf(const TopoDS_Shape& theShape)
+{
+  GProp_GProps aProps;
+  BRepGProp::VolumeProperties(theShape, aProps);
+  return aProps.Mass();
+}
+
+//! True if the shape is one valid solid whose every edge borders two faces.
+bool chamferIsClosedValidSolid(const TopoDS_Shape& theShape)
+{
+  if (theShape.IsNull())
+  {
+    return false;
+  }
+  int aNbSolids = 0;
+  for (TopExp_Explorer anExp(theShape, TopAbs_SOLID); anExp.More(); anExp.Next())
+  {
+    ++aNbSolids;
+  }
+  if (aNbSolids != 1 || !BRepCheck_Analyzer(theShape).IsValid())
+  {
+    return false;
+  }
+  ChamferEdgeFaceMap anEdgeFaces;
+  TopExp::MapShapesAndAncestors(theShape, TopAbs_EDGE, TopAbs_FACE, anEdgeFaces);
+  for (int anIdx = 1; anIdx <= anEdgeFaces.Extent(); ++anIdx)
+  {
+    if (!BRep_Tool::Degenerated(TopoDS::Edge(anEdgeFaces.FindKey(anIdx)))
+        && anEdgeFaces.FindFromIndex(anIdx).Extent() != 2)
+    {
+      return false;
+    }
+  }
+  return true;
+}
+
+//! Direction into theFace away from theEdge, and the width of the face from the edge to the opposite
+//! edge, for a face that is a rectangle with theEdge as one side; the outward normal as well.
+bool chamferRectangleWidth(const TopoDS_Face& theFace,
+                           const TopoDS_Edge& theEdge,
+                           const gp_Pnt&      theOrigin,
+                           const gp_Dir&      theAxis,
+                           gp_Dir&            theAcross,
+                           double&            theWidth,
+                           gp_Dir&            theNormal)
+{
+  BRepAdaptor_Surface aSurf(theFace);
+  if (aSurf.GetType() != GeomAbs_Plane)
+  {
+    return false;
+  }
+  gp_Pnt aPnt;
+  gp_Vec aDU, aDV;
+  aSurf.D1(0., 0., aPnt, aDU, aDV);
+  const gp_Vec aNorm = aDU.Crossed(aDV);
+  if (aNorm.SquareMagnitude() < gp::Resolution())
+  {
+    return false;
+  }
+  theNormal = gp_Dir(aNorm);
+  if (theFace.Orientation() == TopAbs_REVERSED)
+  {
+    theNormal.Reverse();
+  }
+  int aNbEdges = 0, aNbParallel = 0;
+  for (TopExp_Explorer anExp(theFace, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    const TopoDS_Edge& anEdge = TopoDS::Edge(anExp.Current());
+    BRepAdaptor_Curve  aCurve(anEdge);
+    ++aNbEdges;
+    if (aCurve.GetType() != GeomAbs_Line)
+    {
+      return false;
+    }
+    const double aDot = std::abs(aCurve.Line().Direction().Dot(theAxis));
+    if (aDot > 1. - 1.e-9)
+    {
+      if (anEdge.IsSame(theEdge))
+      {
+        continue;
+      }
+      ++aNbParallel;
+      const gp_Vec aVec(theOrigin, aCurve.Value(aCurve.FirstParameter()));
+      const gp_Vec aPerp = aVec - gp_Vec(theAxis) * aVec.Dot(gp_Vec(theAxis));
+      theWidth           = aPerp.Magnitude();
+      if (theWidth < Precision::Confusion())
+      {
+        return false;
+      }
+      theAcross = gp_Dir(aPerp);
+    }
+    else if (aDot > 1.e-9)
+    {
+      return false;
+    }
+  }
+  return aNbEdges == 4 && aNbParallel == 1;
+}
+
+//! The area of the rectangle [0, theA] x [0, theB] on the corner side of the line through (theQ1, 0) and
+//! (0, theQ2): what the chamfer removes from the section.
+double chamferSectionArea(const double theA, const double theB, const double theQ1, const double theQ2)
+{
+  // Corner side: u / theQ1 + v / theQ2 < 1. Integrate the height of the removed strip over u.
+  const int    aN = 4000;
+  const double aDu = theA / aN;
+  double       aSum = 0.;
+  for (int aK = 0; aK < aN; ++aK)
+  {
+    const double aU = (aK + 0.5) * aDu;
+    aSum += std::min(theB, std::max(0., theQ2 * (1. - aU / theQ1))) * aDu;
+  }
+  return aSum;
+}
+
+//! Cuts the chamfer with distance theD1 on theFirst and theD2 on the other face out of theShape (a solid
+//! with a right-angle planar corner along theEdge), or returns a null shape if the configuration is not
+//! that or if the distances run past a face and the compiled reading declines.
+TopoDS_Shape chamferCut(const TopoDS_Shape& theShape,
+                        const TopoDS_Edge&  theEdge,
+                        const TopoDS_Face&  theFirst,
+                        const double        theD1,
+                        const double        theD2)
+{
+  if (!(theD1 > 0.) || !(theD2 > 0.))
+  {
+    return TopoDS_Shape();
+  }
+  BRepAdaptor_Curve aCurve(theEdge);
+  if (aCurve.GetType() != GeomAbs_Line)
+  {
+    return TopoDS_Shape();
+  }
+  int aNbSolids = 0;
+  for (TopExp_Explorer anExp(theShape, TopAbs_SOLID); anExp.More(); anExp.Next())
+  {
+    ++aNbSolids;
+  }
+  ChamferEdgeFaceMap anEdgeFaces;
+  TopExp::MapShapesAndAncestors(theShape, TopAbs_EDGE, TopAbs_FACE, anEdgeFaces);
+  if (aNbSolids != 1 || !anEdgeFaces.Contains(theEdge))
+  {
+    return TopoDS_Shape();
+  }
+  const NCollection_List<TopoDS_Shape>& aFaces = anEdgeFaces.FindFromKey(theEdge);
+  if (aFaces.Extent() != 2 || aFaces.First().IsSame(aFaces.Last()))
+  {
+    return TopoDS_Shape();
+  }
+  const TopoDS_Face aF1 = theFirst.IsNull() || aFaces.First().IsSame(theFirst)
+                            ? TopoDS::Face(aFaces.First())
+                            : TopoDS::Face(aFaces.Last());
+  const TopoDS_Face aF2 =
+    aF1.IsSame(aFaces.First()) ? TopoDS::Face(aFaces.Last()) : TopoDS::Face(aFaces.First());
+  const gp_Dir aAxis   = aCurve.Line().Direction();
+  const gp_Pnt aOrigin = aCurve.Value(aCurve.FirstParameter());
+  const double aLength = aCurve.LastParameter() - aCurve.FirstParameter();
+  gp_Dir       aU, aV, aN1, aN2;
+  double       aA = 0., aB = 0.;
+  if (!chamferRectangleWidth(aF1, theEdge, aOrigin, aAxis, aU, aA, aN1)
+      || !chamferRectangleWidth(aF2, theEdge, aOrigin, aAxis, aV, aB, aN2))
+  {
+    return TopoDS_Shape();
+  }
+  // A convex right angle: each face leads into the material side of the other.
+  if (std::abs(aU.Dot(aV)) > 1.e-7 || aU.Dot(aN2) > -0.5 || aV.Dot(aN1) > -0.5)
+  {
+    return TopoDS_Shape();
+  }
+  // The legs on the two faces. A distance that fits (or reaches the far edge to within confusion) is
+  // used as given; one that runs past its face follows the compiled reading.
+  const double aTol = Precision::Confusion();
+  double       aQ1 = theD1, aQ2 = theD2;
+  bool         aRunsOut = false;
+  if (aQ1 > aA + aTol || aQ2 > aB + aTol)
+  {
+    aRunsOut = true;
+#if BRepFilletAPI_CHAMFER_RUNOUT == 1
+    aQ1 = std::min(aQ1, aA);
+    aQ2 = std::min(aQ2, aB);
+#elif BRepFilletAPI_CHAMFER_RUNOUT != 2
+    return TopoDS_Shape();
+#endif
+  }
+  else
+  {
+    aQ1 = std::min(aQ1, aA);
+    aQ2 = std::min(aQ2, aB);
+  }
+
+  // The tool: the side of the line through (aQ1, 0) and (0, aQ2) that holds the corner, enlarged
+  // beyond the faces, swept along the edge.
+  const double aMargin = 0.1 * (aA + aB + aLength) + 2. * (aQ1 + aQ2);
+  const gp_Vec aStart  = gp_Vec(aAxis) * (-aMargin);
+  auto         aPoint  = [&](const double theUc, const double theVc) {
+    return aOrigin.Translated(gp_Vec(aU) * theUc + gp_Vec(aV) * theVc + aStart);
+  };
+  const double aLn = std::hypot(aQ1, aQ2);
+  const double aTx = aQ1 / aLn, aTy = -aQ2 / aLn;       // unit vector along the line, from (0, q2) to (q1, 0)
+  const double aOx = -aQ2 / aLn, aOy = -aQ1 / aLn;      // unit normal towards the corner side
+  const double aStrip = 2. * (aA + aB + aQ1 + aQ2);
+  const gp_Pnt aP1 = aPoint(aQ1 + aMargin * aTx, aMargin * aTy);
+  const gp_Pnt aP2 = aPoint(-aMargin * aTx, aQ2 - aMargin * aTy);
+  const gp_Pnt aP3 = aPoint(-aMargin * aTx + aStrip * aOx, aQ2 - aMargin * aTy + aStrip * aOy);
+  const gp_Pnt aP4 = aPoint(aQ1 + aMargin * aTx + aStrip * aOx, aMargin * aTy + aStrip * aOy);
+  BRepBuilderAPI_MakePolygon aPoly(aP1, aP2, aP3, aP4, true);
+  if (!aPoly.IsDone())
+  {
+    return TopoDS_Shape();
+  }
+  BRepBuilderAPI_MakeFace aFace(aPoly.Wire(), true);
+  if (!aFace.IsDone())
+  {
+    return TopoDS_Shape();
+  }
+  TopoDS_Shape aTool =
+    BRepPrimAPI_MakePrism(aFace.Face(), gp_Vec(aAxis) * (aLength + 2. * aMargin)).Shape();
+  if (chamferVolumeOf(aTool) < 0.)
+  {
+    aTool.Reverse();
+  }
+  BRepAlgoAPI_Cut aCut(theShape, aTool);
+  if (!aCut.IsDone() || aCut.HasErrors() || !chamferIsClosedValidSolid(aCut.Shape()))
+  {
+    return TopoDS_Shape();
+  }
+  // The section is the same along the edge, so the volume that went is the area times the length. Not
+  // checked for the half-space reading past a face: the cut then reaches into whatever lies beyond the
+  // far edge, which is not the rectangle this area is taken over.
+  const double aVolume  = chamferVolumeOf(theShape);
+  const double aRemoved = chamferSectionArea(aA, aB, aQ1, aQ2) * aLength;
+  const bool   aCheck   = !(aRunsOut && BRepFilletAPI_CHAMFER_RUNOUT == 2);
+  if (aCheck
+      && std::abs(aVolume - chamferVolumeOf(aCut.Shape()) - aRemoved) > 1.e-5 * aRemoved + 1.e-10 * aVolume)
+  {
+    return TopoDS_Shape();
+  }
+  return aCut.Shape();
+}
+
+//! The most contours the fallback intersects: each costs a chamfer and a Boolean operation.
+const int    THE_MAX_CHAMFER_CONTOURS = 8;
+const double THE_HALF_PI              = 1.5707963267948966;
+
+//! The chamfers of the contours of theBuilder, computed after Compute() failed: each contour on its own
+//! (by the same builder, or by a cut when that fails too, as when a distance equals its face), and the
+//! intersection of the results. Chamfers whose cuts meet or cross on a face, and a chamfer whose distance
+//! reaches its far edge, are built this way. The contours must share no vertex. Null if not applicable.
+TopoDS_Shape fallbackChamfers(ChFi3d_ChBuilder& theBuilder)
+{
+  const int aNbContours = theBuilder.NbElements();
+  if (aNbContours < 1 || aNbContours > THE_MAX_CHAMFER_CONTOURS)
+  {
+    return TopoDS_Shape();
+  }
+  const TopoDS_Shape&                                           aShape = theBuilder.InitialShape();
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> aVertices;
+  for (int aContour = 1; aContour <= aNbContours; ++aContour)
+  {
+    const occ::handle<ChFiDS_Spine> aSpine = theBuilder.Value(aContour);
+    if (aSpine.IsNull() || aSpine->NbEdges() < 1)
+    {
+      return TopoDS_Shape();
+    }
+    NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> aOwn;
+    for (int anEdge = 1; anEdge <= aSpine->NbEdges(); ++anEdge)
+    {
+      TopExp::MapShapes(aSpine->Edges(anEdge), TopAbs_VERTEX, aOwn);
+    }
+    for (int aVertex = 1; aVertex <= aOwn.Extent(); ++aVertex)
+    {
+      if (aVertices.Contains(aOwn(aVertex)))
+      {
+        return TopoDS_Shape();
+      }
+    }
+    for (int aVertex = 1; aVertex <= aOwn.Extent(); ++aVertex)
+    {
+      aVertices.Add(aOwn(aVertex));
+    }
+  }
+
+  const double aVolume = chamferVolumeOf(aShape);
+  TopoDS_Shape aResult;
+  double       aSumRemoved = 0., aMaxRemoved = 0.;
+  for (int aContour = 1; aContour <= aNbContours; ++aContour)
+  {
+    const occ::handle<ChFiDS_ChamfSpine> aSpine =
+      occ::down_cast<ChFiDS_ChamfSpine>(theBuilder.Value(aContour));
+    if (aSpine.IsNull())
+    {
+      return TopoDS_Shape();
+    }
+    const TopoDS_Edge& aFirst = aSpine->Edges(1);
+    const TopoDS_Face  aFace  = theBuilder.FirstFaceOf(aFirst);
+    double             aD1 = 0., aD2 = 0., aAngle = 0.;
+    const ChFiDS_ChamfMethod aMethod = aSpine->IsChamfer();
+    if (aMethod == ChFiDS_Sym)
+    {
+      aSpine->GetDist(aD1);
+      aD2 = aD1;
+    }
+    else if (aMethod == ChFiDS_TwoDist)
+    {
+      aSpine->Dists(aD1, aD2);
+    }
+    else
+    {
+      aSpine->GetDistAngle(aD1, aAngle);
+      if (!(aAngle > 0.) || !(aAngle < THE_HALF_PI))
+      {
+        return TopoDS_Shape();
+      }
+      aD2 = aD1 * std::tan(aAngle);
+    }
+    TopoDS_Shape aOne;
+    if (aNbContours > 1)
+    {
+      BRepFilletAPI_MakeChamfer aSingle(aShape);
+      if (aMethod == ChFiDS_Sym)
+      {
+        aSingle.Add(aD1, aFirst);
+      }
+      else if (aMethod == ChFiDS_TwoDist)
+      {
+        aSingle.Add(aD1, aD2, aFirst, aFace);
+      }
+      else
+      {
+        aSingle.AddDA(aD1, aAngle, aFirst, aFace);
+      }
+      aSingle.Build();
+      if (aSingle.IsDone() && chamferIsClosedValidSolid(aSingle.Shape()))
+      {
+        aOne = aSingle.Shape();
+      }
+    }
+    if (aOne.IsNull() && aSpine->NbEdges() == 1)
+    {
+      aOne = chamferCut(aShape, aFirst, aFace, aD1, aD2);
+    }
+    if (aOne.IsNull())
+    {
+      return TopoDS_Shape();
+    }
+    const double aRemoved = aVolume - chamferVolumeOf(aOne);
+    if (aRemoved <= 0.)
+    {
+      // Only chamfers that take material away are an intersection.
+      return TopoDS_Shape();
+    }
+    aSumRemoved += aRemoved;
+    aMaxRemoved = std::max(aMaxRemoved, aRemoved);
+    if (aResult.IsNull())
+    {
+      aResult = aOne;
+      continue;
+    }
+    BRepAlgoAPI_Common aCommon(aResult, aOne);
+    if (!aCommon.IsDone() || aCommon.HasErrors() || !chamferIsClosedValidSolid(aCommon.Shape()))
+    {
+      return TopoDS_Shape();
+    }
+    aResult = aCommon.Shape();
+  }
+  // What the intersection removes is at least what any one chamfer removes and at most the sum.
+  const double aTol     = 1.e-6 * aVolume;
+  const double aRemoved = aVolume - chamferVolumeOf(aResult);
+  if (aRemoved < aMaxRemoved - aTol || aRemoved > aSumRemoved + aTol)
+  {
+    return TopoDS_Shape();
+  }
+  return aResult;
+}
+} // namespace
 
 //=================================================================================================
 
@@ -275,7 +694,31 @@ occ::handle<TopOpeBRepBuild_HBuilder> BRepFilletAPI_MakeChamfer::Builder() const
 void BRepFilletAPI_MakeChamfer::Build(const Message_ProgressRange& /*theRange*/)
 {
   myBuilder.Compute();
-  if (myBuilder.IsDone())
+  if (!myBuilder.IsDone())
+  {
+    // Chamfers whose cuts meet or cross, and a distance that reaches its far edge: see fallbackChamfers.
+    TopoDS_Shape aFallback;
+    try
+    {
+      aFallback = fallbackChamfers(myBuilder);
+    }
+    catch (Standard_Failure const&)
+    {
+    }
+    if (!aFallback.IsNull())
+    {
+      // The failed computation holds nothing of this result: clear its faulty contours.
+      myBuilder.Reset();
+      Done();
+      myShape = aFallback;
+      myMap.Clear();
+      for (TopExp_Explorer anExp(myShape, TopAbs_FACE); anExp.More(); anExp.Next())
+      {
+        myMap.Add(anExp.Current());
+      }
+    }
+  }
+  else
   {
     Done();
     myShape = myBuilder.Shape();
