+//! The straight edge of the box whose middle is at the given point.
+TopoDS_Edge chamferEdgeAt(const TopoDS_Shape& theShape, const gp_Pnt& theMiddle)
+{
+  for (TopExp_Explorer anExp(theShape, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    const TopoDS_Edge& anEdge = TopoDS::Edge(anExp.Current());
+    BRepAdaptor_Curve  aCurve(anEdge);
+    const gp_Pnt aMiddle = aCurve.Value(0.5 * (aCurve.FirstParameter() + aCurve.LastParameter()));
+    if (aMiddle.Distance(theMiddle) < 1.e-7)
+    {
+      return anEdge;
+    }
+  }
+  return TopoDS_Edge();
+}
+
+//! The face of the box whose middle (centre of its bounding box, for a rectangle) is at the given point.
+TopoDS_Face chamferFaceAt(const TopoDS_Shape& theShape, const gp_Pnt& theMiddle)
+{
+  for (TopExp_Explorer anExp(theShape, TopAbs_FACE); anExp.More(); anExp.Next())
+  {
+    GProp_GProps aProps;
+    BRepGProp::SurfaceProperties(anExp.Current(), aProps);
+    if (aProps.CentreOfMass().Distance(theMiddle) < 1.e-7)
+    {
+      return TopoDS::Face(anExp.Current());
+    }
+  }
+  return TopoDS_Face();
+}
+
+double chamferVolume(const TopoDS_Shape& theShape)
+{
+  GProp_GProps aProps;
+  BRepGProp::VolumeProperties(theShape, aProps);
+  return aProps.Mass();
+}
+} // namespace
