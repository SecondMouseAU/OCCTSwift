+TEST(BRepFilletAPI_MakeChamferTest, DistanceEqualToTheFaceReachesTheFarEdge)
+{
+  // 4 on a 4 wide top face, 2 on the wall: the cut runs from the far edge of the top face to 2 down the
+  // wall. Section area 24 - 4 = 20 less the cut triangle 4: volume 200.
+  const TopoDS_Shape aBox = BRepPrimAPI_MakeBox(4.0, 10.0, 6.0).Shape();
+  BRepFilletAPI_MakeChamfer aChamfer(aBox);
+  aChamfer.Add(4.0, 2.0, chamferEdgeAt(aBox, gp_Pnt(0., 5., 6.)), chamferFaceAt(aBox, gp_Pnt(2., 5., 6.)));
+  aChamfer.Build();
+  ASSERT_TRUE(aChamfer.IsDone());
+  EXPECT_TRUE(BRepCheck_Analyzer(aChamfer.Shape()).IsValid());
+  EXPECT_NEAR(chamferVolume(aChamfer.Shape()), 200.0, 1.e-6);
+}
+
+TEST(BRepFilletAPI_MakeChamferTest, TwoChamfersThatMeetOnTheFace)
+{
+  // 2 and 2 on the two top edges of a 4 wide face: the cuts meet at the middle of the top face.
+  const TopoDS_Shape aBox = BRepPrimAPI_MakeBox(4.0, 10.0, 6.0).Shape();
+  BRepFilletAPI_MakeChamfer aChamfer(aBox);
+  aChamfer.Add(2.0, chamferEdgeAt(aBox, gp_Pnt(0., 5., 6.)));
+  aChamfer.Add(2.0, chamferEdgeAt(aBox, gp_Pnt(4., 5., 6.)));
+  aChamfer.Build();
+  ASSERT_TRUE(aChamfer.IsDone());
+  EXPECT_TRUE(BRepCheck_Analyzer(aChamfer.Shape()).IsValid());
+  EXPECT_NEAR(chamferVolume(aChamfer.Shape()), 200.0, 1.e-6);
+}
+
+TEST(BRepFilletAPI_MakeChamferTest, TwoChamfersThatCrossOnTheFace)
+{
+  // 3 and 3: the cuts cross below the top face and the top face is gone. Section area 16.
+  const TopoDS_Shape aBox = BRepPrimAPI_MakeBox(4.0, 10.0, 6.0).Shape();
+  BRepFilletAPI_MakeChamfer aChamfer(aBox);
+  aChamfer.Add(3.0, chamferEdgeAt(aBox, gp_Pnt(0., 5., 6.)));
+  aChamfer.Add(3.0, chamferEdgeAt(aBox, gp_Pnt(4., 5., 6.)));
+  aChamfer.Build();
+  ASSERT_TRUE(aChamfer.IsDone());
+  EXPECT_TRUE(BRepCheck_Analyzer(aChamfer.Shape()).IsValid());
+  EXPECT_NEAR(chamferVolume(aChamfer.Shape()), 160.0, 1.e-6);
+}
+
+TEST(BRepFilletAPI_MakeChamferTest, DistanceAndAngleReachingTheFarEdge)
+{
+  // 4 and 26.565 degrees (tan = 0.5): the wall distance is 2, the same cut as above.
+  const TopoDS_Shape aBox = BRepPrimAPI_MakeBox(4.0, 10.0, 6.0).Shape();
+  BRepFilletAPI_MakeChamfer aChamfer(aBox);
+  aChamfer.AddDA(4.0, std::atan(0.5), chamferEdgeAt(aBox, gp_Pnt(0., 5., 6.)), chamferFaceAt(aBox, gp_Pnt(2., 5., 6.)));
+  aChamfer.Build();
+  ASSERT_TRUE(aChamfer.IsDone());
+  EXPECT_NEAR(chamferVolume(aChamfer.Shape()), 200.0, 1.e-6);
+}
