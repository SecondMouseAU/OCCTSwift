+  EXPECT_TRUE(BRepCheck_Analyzer(aFillet.Shape()).IsValid());
+  EXPECT_NEAR(volumeOf(aFillet.Shape()), 240.0 - 10.0 * 2.840940340, 1.e-6);
+}
