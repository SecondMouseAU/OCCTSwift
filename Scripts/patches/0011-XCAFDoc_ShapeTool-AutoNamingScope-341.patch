+++ b/src/DataExchange/TKXCAF/XCAFDoc/XCAFDoc_ShapeTool.hxx
@@ -255,6 +255,47 @@ public:
   //! description.
   Standard_EXPORT static bool AutoNaming();
 
+  //! Returns the auto-naming mode as seen by THIS ShapeTool instance: its own local
+  //! override if SetOwnAutoNaming() was called, otherwise the process-wide default
+  //! (AutoNaming()). Every internal auto-naming check (AddShape, MakeReference, SetSHUO)
+  //! reads this instead of the global flag directly.
+  bool OwnAutoNaming() const
+  {
+    return myOwnAutonaming == -1 ? XCAFDoc_ShapeTool::AutoNaming() : myOwnAutonaming == 1;
+  }
+
+  //! Locally overrides the auto-naming mode for this instance only -- does not touch the
+  //! process-wide default (SetAutoNaming()) or any other document's ShapeTool. Prefer
+  //! OwnAutoNamingScope over a bare Set/Unset pair so a local override can't leak past an
+  //! exception or an early return.
+  void SetOwnAutoNaming(const bool theOwnFlag) { myOwnAutonaming = theOwnFlag ? 1 : 0; }
+
+  //! Resets this instance to inherit the process-wide default (AutoNaming()) again.
+  void UnsetOwnAutoNaming() { myOwnAutonaming = -1; }
+
+  //! RAII scope: locally overrides auto-naming on ONE ShapeTool instance (one document),
+  //! restoring whatever local-override state that instance had on entry -- not just "off"
+  //! -- when the scope ends. Because the override lives on the instance rather than a
+  //! process-wide flag, two threads working on two different documents never touch
+  //! anything shared and need no lock; and because construction/destruction save/restore
+  //! symmetrically (not unconditionally reset to "inherit global"), nested scopes on the
+  //! SAME instance compose correctly -- e.g. XCAFDoc_Editor::Expand() recursing into
+  //! itself on the same document.
+  class OwnAutoNamingScope
+  {
+  public:
+    Standard_EXPORT OwnAutoNamingScope(const occ::handle<XCAFDoc_ShapeTool>& theTool,
+                                        const bool                           theTemporaryValue);
+    Standard_EXPORT ~OwnAutoNamingScope();
+
+    OwnAutoNamingScope(const OwnAutoNamingScope&)            = delete;
+    OwnAutoNamingScope& operator=(const OwnAutoNamingScope&) = delete;
+
+  private:
+    occ::handle<XCAFDoc_ShapeTool> myTool;
+    int                            myWasOwnAutoNaming;
+  };
+
   //! recursive
   Standard_EXPORT void ComputeShapes(const TDF_Label& L);
 
