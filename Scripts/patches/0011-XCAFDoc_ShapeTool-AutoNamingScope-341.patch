+namespace
+{
+std::recursive_mutex& AutoNamingScopeMutex()
+{
+  static std::recursive_mutex aMutex;
+  return aMutex;
+}
+} // namespace
+
+XCAFDoc_ShapeTool::AutoNamingScope::AutoNamingScope(const bool theTemporaryValue)
+{
+  AutoNamingScopeMutex().lock();
+  myWasAutoNaming = theAutoNaming;
+  theAutoNaming   = theTemporaryValue;
+}
+
+XCAFDoc_ShapeTool::AutoNamingScope::~AutoNamingScope()
+{
+  theAutoNaming = myWasAutoNaming;
+  AutoNamingScopeMutex().unlock();
+}
