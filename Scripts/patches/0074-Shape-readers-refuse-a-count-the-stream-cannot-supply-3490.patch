+//! Tells whether a polygon's nodes are all nodes of the triangulation it is attached to.
+static bool IsPolygonOfTriangulation(const occ::handle<Poly_PolygonOnTriangulation>& thePolygon,
+                                     const occ::handle<Poly_Triangulation>& theTriangulation)
+{
+  if (thePolygon.IsNull() || theTriangulation.IsNull())
+  {
+    return false;
+  }
+  const NCollection_Array1<int>& aNodes = thePolygon->Nodes();
+  for (int aNodeIter = aNodes.Lower(); aNodeIter <= aNodes.Upper(); ++aNodeIter)
+  {
+    if (aNodes.Value(aNodeIter) < 1 || aNodes.Value(aNodeIter) > theTriangulation->NbNodes())
+    {
+      return false;
+    }
+  }
+  return true;
+}
