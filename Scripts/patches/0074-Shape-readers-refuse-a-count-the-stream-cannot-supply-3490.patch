diff --git a/src/FoundationClasses/TKernel/Standard/Standard_IStream.hxx b/src/FoundationClasses/TKernel/Standard/Standard_IStream.hxx
--- a/src/FoundationClasses/TKernel/Standard/Standard_IStream.hxx
+++ b/src/FoundationClasses/TKernel/Standard/Standard_IStream.hxx
@@ -25,4 +25,45 @@
 
 typedef std::istream Standard_IStream;
 
+//! Tells whether a stream can still supply a count of items it has just declared.
+//! A count that is negative, or a failed stream, is refused. A count of 4096 or less is allowed,
+//! since a reader that checks the stream after each item stops on the first one that is missing.
+//! A larger count is allowed when the characters left in the stream, theMinChars to an item
+//! (separator included), can hold it; a stream that cannot be measured (not seekable) allows up
+//! to 2^24 items. The state and the position of the stream are unchanged.
+inline bool Standard_IStreamHasItems(Standard_IStream& theIS,
+                                     const long long   theCount,
+                                     const int         theMinChars)
+{
+  if (theCount < 0 || theIS.fail())
+  {
+    return false;
+  }
+  if (theCount <= 4096)
+  {
+    return true;
+  }
+  if (theIS.eof())
+  {
+    return false;
+  }
+  const std::ios::iostate aState = theIS.rdstate();
+  const std::streampos    aPos   = theIS.tellg();
+  bool                    isOk   = theCount <= (1 << 24);
+  if (aPos != std::streampos(-1))
+  {
+    theIS.seekg(0, std::ios::end);
+    const std::streampos anEnd = theIS.tellg();
+    if (anEnd != std::streampos(-1))
+    {
+      // the last item needs no separator
+      isOk = theCount <= (std::streamoff(anEnd - aPos) + 1) / theMinChars;
+    }
+    theIS.clear();
+    theIS.seekg(aPos);
+  }
+  theIS.clear(aState);
+  return isOk;
+}
+
 #endif
