@@ -30,6 +30,7 @@
 #include <BOPTools_AlgoTools.hxx>
 #include <BOPTools_Parallel.hxx>
 #include <BRepBuilderAPI_Copy.hxx>
+#include <Intf_Interference.hxx>
 #include <IntTools_Context.hxx>
