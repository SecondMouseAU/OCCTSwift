+      myShape = aFallback;
+      myMap.Clear();
+      for (TopExp_Explorer anExp(myShape, TopAbs_FACE); anExp.More(); anExp.Next())
+      {
+        myMap.Add(anExp.Current());
+      }
+    }
+  }
+  else
   {
     Done();
     myShape = myBuilder.Shape();
