+TEST(BRepFilletAPI_MakeFilletTest, FilletWiderThanItsFaceOnAnAcuteEdgeEndsAtTheFarEdge)
+{
+  // 45 degree edge, faces 4 and 6 wide, r = 2: the tangent length 4.83 is past the 4 wide face, so
+  // its far edge is the pivot and the arc stays tangent to the other face. Removed area 4.398801.
+  const TopoDS_Shape       aPrism = parallelogramPrism(45.);
+  BRepFilletAPI_MakeFillet aFillet(aPrism);
+  aFillet.Add(2.0, findEdgeAt(aPrism, gp_Pnt(0.0, 5.0, 0.0)));
+  aFillet.Build();
+  ASSERT_TRUE(aFillet.IsDone());
+  EXPECT_TRUE(BRepCheck_Analyzer(aFillet.Shape()).IsValid());
+  EXPECT_NEAR(volumeOf(aFillet.Shape()), 125.715761, 1.e-4);
+}
