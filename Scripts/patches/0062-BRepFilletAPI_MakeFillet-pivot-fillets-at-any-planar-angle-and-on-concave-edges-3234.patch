+//! The polygon (x, z pairs, y = 0) extruded 10 along +Y.
+TopoDS_Shape prismOfSection(const NCollection_Array1<gp_Pnt>& thePoints)
+{
+  BRepBuilderAPI_MakePolygon aPoly;
+  for (int anIdx = thePoints.Lower(); anIdx <= thePoints.Upper(); ++anIdx)
+  {
+    aPoly.Add(thePoints(anIdx));
+  }
+  aPoly.Close();
+  TopoDS_Shape aPrism =
+    BRepPrimAPI_MakePrism(BRepBuilderAPI_MakeFace(aPoly.Wire(), true).Face(), gp_Vec(0., 10., 0.))
+      .Shape();
+  if (volumeOf(aPrism) < 0.)
+  {
+    aPrism.Reverse();
+  }
+  return aPrism;
+}
+
+//! The prism of the 45 or 60 degree parallelogram: the edge at the origin between a face 4 wide
+//! along x and one 6 wide at the angle theDegrees below it.
+TopoDS_Shape parallelogramPrism(const double theDegrees)
+{
+  const double               aC = std::cos(theDegrees * M_PI / 180.);
+  const double               aS = std::sin(theDegrees * M_PI / 180.);
+  NCollection_Array1<gp_Pnt> aPts(1, 4);
+  aPts(1) = gp_Pnt(4., 0., 0.);
+  aPts(2) = gp_Pnt(0., 0., 0.);
+  aPts(3) = gp_Pnt(6. * aC, 0., -6. * aS);
+  aPts(4) = gp_Pnt(4. + 6. * aC, 0., -6. * aS);
+  return prismOfSection(aPts);
+}
+
+//! The L profile: foot 3 thick and 6 wide, wall 2 thick and 6 high; the inside corner is the edge
+//! at (2, y, 3), the foot top reaching 4 from it and the wall 3 above it.
+TopoDS_Shape lProfilePrism()
+{
+  NCollection_Array1<gp_Pnt> aPts(1, 6);
+  aPts(1) = gp_Pnt(0., 0., 0.);
+  aPts(2) = gp_Pnt(6., 0., 0.);
+  aPts(3) = gp_Pnt(6., 0., 3.);
+  aPts(4) = gp_Pnt(2., 0., 3.);
+  aPts(5) = gp_Pnt(2., 0., 6.);
+  aPts(6) = gp_Pnt(0., 0., 6.);
+  return prismOfSection(aPts);
+}
