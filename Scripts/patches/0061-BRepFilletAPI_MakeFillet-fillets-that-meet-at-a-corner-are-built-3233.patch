+  aFillet.Add(2.0, findEdgeAt(aBox, gp_Pnt(0.0, 0.0, 3.0)));
+  aFillet.Build();
+  ASSERT_TRUE(aFillet.IsDone());
+  EXPECT_TRUE(BRepCheck_Analyzer(aFillet.Shape()).IsValid());
+  EXPECT_LT(volumeOf(aFillet.Shape()), 240.0);
