+  aFillet.Add(2.0, findEdgeAt(aBox, gp_Pnt(2.0, 10.0, 6.0)));
+  aFillet.Add(2.0, findEdgeAt(aBox, gp_Pnt(0.0, 5.0, 6.0)));
+  aFillet.Add(2.0, findEdgeAt(aBox, gp_Pnt(0.0, 0.0, 3.0)));
+  aFillet.Add(2.0, findEdgeAt(aBox, gp_Pnt(4.0, 0.0, 3.0)));
+  aFillet.Add(2.0, findEdgeAt(aBox, gp_Pnt(4.0, 10.0, 3.0)));
