+
+TEST(BRepFilletAPI_MakeFilletTest, FrameOfFilletsWhoseArcsCrossIsTheirIntersection)
+{
+  // All four top edges of a 4 x 10 x 6 box with r = 3: the long edges' arcs cross (r > w / 2) and
+  // the end edges meet them at the corners. Compute() answers done with an open shell here; the
+  // result is the intersection of the four single-edge fillets, 196.8401939 (the box minus the
+  // prisms of the four removed sections, a boolean of simple solids).
+  const TopoDS_Shape       aBox = BRepPrimAPI_MakeBox(4.0, 10.0, 6.0).Shape();
+  BRepFilletAPI_MakeFillet aFillet(aBox);
+  aFillet.Add(3.0, findEdgeAt(aBox, gp_Pnt(2.0, 0.0, 6.0)));
+  aFillet.Add(3.0, findEdgeAt(aBox, gp_Pnt(4.0, 5.0, 6.0)));
+  aFillet.Add(3.0, findEdgeAt(aBox, gp_Pnt(2.0, 10.0, 6.0)));
+  aFillet.Add(3.0, findEdgeAt(aBox, gp_Pnt(0.0, 5.0, 6.0)));
+  aFillet.Build();
+  ASSERT_TRUE(aFillet.IsDone());
+  EXPECT_TRUE(BRepCheck_Analyzer(aFillet.Shape()).IsValid());
+  EXPECT_NEAR(volumeOf(aFillet.Shape()), 196.8401939, 1.e-5);
+}
+
+TEST(BRepFilletAPI_MakeFilletTest, AdjacentFilletsOneOfThemWiderThanItsFaceMeetInTheirIntersection)
+{
+  // The left top edge with r = 4.5 on the 4 wide top face (pivot at the far top edge) and the front
+  // top edge with r = 1, meeting at the corner (0, 0, 6). Intersection of the two single-edge
+  // results, 197.5166640.
+  const TopoDS_Shape       aBox = BRepPrimAPI_MakeBox(4.0, 10.0, 6.0).Shape();
+  BRepFilletAPI_MakeFillet aFillet(aBox);
+  aFillet.Add(4.5, findEdgeAt(aBox, gp_Pnt(0.0, 5.0, 6.0)));
+  aFillet.Add(1.0, findEdgeAt(aBox, gp_Pnt(2.0, 0.0, 6.0)));
+  aFillet.Build();
+  ASSERT_TRUE(aFillet.IsDone());
+  EXPECT_TRUE(BRepCheck_Analyzer(aFillet.Shape()).IsValid());
+  // The default volume integration over the mitre curve is good to about 2e-4 here.
+  EXPECT_NEAR(volumeOf(aFillet.Shape()), 197.5166640, 5.e-4);
+}
