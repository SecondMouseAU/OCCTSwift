+  myFILE = fdopen(myFileChannel, "w+");
   #else
   char aTmpName[] = "/tmp/CSFXXXXXX";
   myFileChannel   = mkstemp(aTmpName);
   const TCollection_AsciiString aName(aTmpName);
   const OSD_Path                aPath(aName);
   SetPath(aPath);
   myFILE = fdopen(myFileChannel, "w+");
   #endif
   myMode = OSD_ReadWrite;
 
 #endif
 }
 
