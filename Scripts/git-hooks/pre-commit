#!/usr/bin/env bash
#
# Opt-in pre-commit hook: runs the same static gate scripts and censuses CI's `gate-scripts` job
# runs, flag for flag, plus the bridge clang-format check from CI's `code-style` job.
#
# NOT installed by cloning. A repo cannot install its own hooks, `.git/hooks` is not versioned,
# and that is the right default here: a hook that appears in a contributor's workflow without them
# asking is a surprise, and this one adds a few seconds to every single commit. Enable it with one
# of the two commands below, from the repo root.
#
#   In a MAIN checkout, surgical, leaves any other hook you already have in place:
#
#       ln -s ../../Scripts/git-hooks/pre-commit .git/hooks/pre-commit
#
#   In a LINKED WORKTREE (`.claude/worktrees/*`, where most work on this repo happens) that symlink
#   FAILS with "Not a directory": a worktree's `.git` is a file pointing at the main checkout, not
#   a directory, so there is no `.git/hooks` to link into. Use either:
#
#       git config core.hooksPath Scripts/git-hooks                    # per-worktree, no symlink
#       ln -s <main-checkout>/Scripts/git-hooks/pre-commit \
#             <main-checkout>/.git/hooks/pre-commit                    # once, covers every worktree
#
#   `core.hooksPath` REPLACES the hooks directory rather than adding to it, so any hook you already
#   have in `.git/hooks` stops firing while it is set. Prefer the symlink where you can use one.
#   Undo either with `rm .git/hooks/pre-commit` or `git config --unset core.hooksPath`.
#
#   The hook body itself is worktree-correct either way, it `cd`s to `git rev-parse --show-toplevel`,
#   which resolves to the worktree you are committing in, not the main checkout.
#
# Skip it for one commit with `git commit --no-verify`. CI is the authority either way: this hook is
# a faster local copy of the same checks, never a substitute. The INVOCATIONS below are
# deliberately identical to the CI job's, flag for flag, so a disagreement can never come from the
# two running different things. Three ways they can still diverge, none of them worth closing here:
#
#   - it checks the WORKING TREE, not the staged snapshot, so a partially-staged commit can pass the
#     hook and fail CI on what was actually committed. Fixing it means checking the index out to a
#     temp tree on every commit, which costs more than it saves for a convenience hook;
#   - it runs whatever `python3` is on your PATH; CI pins 3.12;
#   - if `python3` is missing entirely it warns and exits 0, so "the hook passed" can mean "the hook
#     did nothing". The bridge clang-format check warns and passes the same way when clang-format is
#     absent or is a major version that disagrees with Scripts/clang-format-version.txt.
#
# All three resolve the same way: CI is what decides, and it runs on every push regardless. #625.
#
# It does NOT cover the rest of the `code-style` job: swift-format, SwiftLint and
# check-style-manifest.py are still push-and-find-out. clang-format is here because it is the only
# one of them whose findings are wholly mechanical, so the hook can point at a one-command fix
# (`Scripts/format-bridge.sh`) rather than at prose that needs rewriting.

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

PY="${PYTHON:-python3}"
if ! command -v "$PY" >/dev/null 2>&1; then
    echo "pre-commit: $PY not found; skipping the gate scripts (CI still runs them)." >&2
    exit 0
fi

failed=()

# Run every gate even after one fails, so a commit reports all its problems at once rather than one
# per attempt, same reason CI's steps carry `if: !cancelled()`.
run() {
    local label="$1"; shift
    if ! "$PY" "$@" >/tmp/occtswift-gate-$$.log 2>&1; then
        echo ""
        echo "--- FAIL: $label"
        cat /tmp/occtswift-gate-$$.log
        failed+=("$label")
    fi
    rm -f /tmp/occtswift-gate-$$.log
}

# Deliberately NOT --quiet, even though run() only prints on failure. --quiet is exit-status-only,
# so the hook would name the failing gate and then print nothing about WHERE, a fabricated index
# entry gets you "FAIL: check-bridge-index.py" instead of the file and line CI names. These are the
# same invocations CI runs, which is the point: the two must not be able to disagree.
run "check-bridge-index.py --self-test"       Scripts/check-bridge-index.py --self-test
run "check-bridge-index.py"                   Scripts/check-bridge-index.py
run "check-null-handle-guards.py --self-test" Scripts/check-null-handle-guards.py --self-test
run "check-null-handle-guards.py"             Scripts/check-null-handle-guards.py
run "check-docs-defaults.py --self-test"      Scripts/check-docs-defaults.py --self-test
run "check-docs-defaults.py"                  Scripts/check-docs-defaults.py
run "check-docs-existence.py --self-test"     Scripts/check-docs-existence.py --self-test
run "check-docs-existence.py"                 Scripts/check-docs-existence.py
# #965. A struct has no deinit, so a struct storing an OCCT*Ref borrows a handle whose lifetime
# it does not control. Nineteen such views were a use-after-free; this is what keeps a twentieth
# from being written.
run "check-borrowed-handles.py --self-test"   Scripts/check-borrowed-handles.py --self-test
run "check-borrowed-handles.py"               Scripts/check-borrowed-handles.py
run "derive-bridge-header-split.py --self-test" Scripts/derive-bridge-header-split.py --self-test
run "derive-bridge-header-split.py --verify"    Scripts/derive-bridge-header-split.py --verify
# #996. Only --verify, matching CI: --reverify-headers needs Libraries/OCCT.xcframework and reports
# SKIPPED without it, so putting it here would add a step that usually does nothing.
run "derive-gdt-enums.py --self-test"         Scripts/derive-gdt-enums.py --self-test
run "derive-gdt-enums.py --verify"            Scripts/derive-gdt-enums.py --verify
run "count-operations.py"                     Scripts/count-operations.py

# Not a Python gate, so it does not go through run(). merge.conflictStyle is diff3 in this repo, and
# a resolver written for the default two-way style strips <<<<<<< / ======= / >>>>>>> and leaves the
# ||||||| ancestor line behind. Five reached docs/CHANGELOG.md before anyone noticed.
if git grep -nE '^(<<<<<<< |\|\|\|\|\|\|\| |>>>>>>> )' -- . ; then
    echo ""
    echo "--- FAIL: merge conflict markers in tracked files (listed above)"
    failed+=("conflict-markers")
fi
# Self-test only. census-unmeasured-values.py is #726's census, not a gate: it exits 0 whether or
# not it finds sites, because its output is a list for a human to adjudicate rather than a verdict.
# Running it bare here would add a check that cannot fail. Its detector can still go blind, so that
# is what both this hook and CI hold it to.
run "census-unmeasured-values.py --self-test" Scripts/census-unmeasured-values.py --self-test
# #742. Self-test only in the hook: the real run needs the full merge history of the branch,
# which is present locally but is a report rather than a verdict, so it belongs in CI's log
# rather than in the path of every commit.
run "check-changelog-transcription.py --self-test" Scripts/check-changelog-transcription.py --self-test
# #928's over-coverage detector. Self-test only, like the census above and for the same reason: it
# exits 0 either way. Its bare run also needs Libraries/OCCT.xcframework for the class-existence
# half, which a fresh clone does not have.
run "census-doc-occt-attribution.py --self-test" Scripts/census-doc-occt-attribution.py --self-test
# #1057's census. Self-test only, like the two above and for the same reason: it exits 0 either
# way, since a bare run lists `@Test(arguments:)` element types for a human to judge rather than
# reaching a verdict.
run "census-arguments-tuple-shapes.py --self-test" Scripts/census-arguments-tuple-shapes.py --self-test

# The bridge's clang-format check, from a DIFFERENT CI job (`code-style`, not `gate-scripts`) and
# not a Python gate, so it does not go through run() either. Here because it is the check that was
# costing the most round trips: every one of Sources/OCCTBridge's 33 files is now off the exemption
# manifest and enforced, and OCCT's style aligns consecutive declarations and assignments, so
# almost any hand-written addition to a bridge .mm violates it. Finding that out from a red PR
# rather than from a commit is a push-and-wait cycle per attempt.
#
# CI and this hook run the SAME script with the SAME flags, which is stronger than the flag-for-flag
# duplication the Python gates above rely on: there is only one copy of the file selection and the
# check loop.
#
# Exit codes are NOT all treated as failure, deliberately. 1 means a real violation and blocks the
# commit. Anything else means the check could not run (clang-format absent, or a major version that
# disagrees with Scripts/clang-format-version.txt) and only warns, matching how a missing python3 is
# handled above: CI pins the version exactly and is the authority, so local drift should not stand
# between you and a commit that touches no bridge file at all.
if command -v "${CLANG_FORMAT:-clang-format}" >/dev/null 2>&1; then
    Scripts/format-bridge.sh --self-test >/tmp/occtswift-cf-$$.log 2>&1
    if [ $? -ne 0 ]; then
        echo ""
        echo "--- FAIL: format-bridge.sh --self-test"
        cat /tmp/occtswift-cf-$$.log
        failed+=("format-bridge.sh --self-test")
    fi

    Scripts/format-bridge.sh --check >/tmp/occtswift-cf-$$.log 2>&1
    case $? in
        0) ;;
        1)
            echo ""
            echo "--- FAIL: clang-format (Sources/OCCTBridge)"
            cat /tmp/occtswift-cf-$$.log
            failed+=("clang-format")
            ;;
        *)
            echo ""
            echo "pre-commit: bridge clang-format check skipped (CI still runs it):" >&2
            cat /tmp/occtswift-cf-$$.log >&2
            ;;
    esac
    rm -f /tmp/occtswift-cf-$$.log
else
    echo "pre-commit: clang-format not found; skipping the bridge format check (CI still runs it)." >&2
fi

if [ ${#failed[@]} -ne 0 ]; then
    echo ""
    echo "pre-commit: ${#failed[@]} gate(s) failed: ${failed[*]}"
    echo "Fix them, or commit with --no-verify if you intend to fix them in a follow-up."
    exit 1
fi

exit 0
