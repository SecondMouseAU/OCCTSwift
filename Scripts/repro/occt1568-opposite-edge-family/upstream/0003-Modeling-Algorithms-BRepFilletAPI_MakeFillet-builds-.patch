From 72978f7e219708ba492af70ce5d6079bf2de3c18 Mon Sep 17 00:00:00 2001
From: gsdali <51393997+gsdali@users.noreply.github.com>
Date: Mon, 12 Oct 2026 18:04:52 +1100
Subject: [PATCH] Modeling Algorithms - BRepFilletAPI_MakeFillet builds fillets
 on opposite edges whose arcs cross

Two fillets on the opposite edges of a face with r1 + r2 > w (a 4 mm face, 3 and 3) are refused
by the stripe builder, which has no section curve for stripes that cross (#1177).

When Compute() fails for contours that share no vertex and are all of constant radius, Build now
returns the intersection (BRepAlgoAPI_Common) of the shape filleted on each contour alone: each
arc stays tangent to the face it starts on and the arcs cross on the face between them. The
result must be one valid closed solid that removes at least the largest and at most the sum of
what each contour removes; otherwise the failure stands.

ChFi3d_Builder gains the inline accessor InitialShape().
---
 .../BRepFilletAPI_MakeFillet.cxx              | 176 +++++++++++++++++-
 .../TKFillet/ChFi3d/ChFi3d_Builder.hxx        |   3 +
 ...illetAPI_MakeFillet_OppositeEdges_Test.cxx |  44 +++++
 3 files changed, 222 insertions(+), 1 deletion(-)

diff --git a/src/ModelingAlgorithms/TKFillet/BRepFilletAPI/BRepFilletAPI_MakeFillet.cxx b/src/ModelingAlgorithms/TKFillet/BRepFilletAPI/BRepFilletAPI_MakeFillet.cxx
index f192eb5fa..454aad114 100644
--- a/src/ModelingAlgorithms/TKFillet/BRepFilletAPI/BRepFilletAPI_MakeFillet.cxx
+++ b/src/ModelingAlgorithms/TKFillet/BRepFilletAPI/BRepFilletAPI_MakeFillet.cxx
@@ -14,18 +14,168 @@
 // Alternatively, this file may be used under the terms of Open CASCADE
 // commercial license or contractual agreement.
 
+#include <algorithm>
+
+#include <BRep_Tool.hxx>
+#include <BRepAlgoAPI_Common.hxx>
+#include <BRepCheck_Analyzer.hxx>
 #include <BRepFilletAPI_MakeFillet.hxx>
+#include <BRepGProp.hxx>
 #include <ChFiDS_ErrorStatus.hxx>
 #include <ChFiDS_Spine.hxx>
 #include <Geom_Surface.hxx>
+#include <GProp_GProps.hxx>
 #include <Law_Linear.hxx>
+#include <NCollection_IndexedDataMap.hxx>
+#include <NCollection_IndexedMap.hxx>
 #include <Precision.hxx>
+#include <Standard_Failure.hxx>
+#include <TopExp.hxx>
 #include <TopExp_Explorer.hxx>
+#include <TopoDS.hxx>
 #include <TopoDS_Edge.hxx>
 #include <TopoDS_Shape.hxx>
 #include <TopoDS_Vertex.hxx>
 #include <TopOpeBRepBuild_HBuilder.hxx>
 #include <TopOpeBRepDS_HDataStructure.hxx>
+#include <TopTools_ShapeMapHasher.hxx>
+
+namespace
+{
+typedef NCollection_IndexedDataMap<TopoDS_Shape,
+                                   NCollection_List<TopoDS_Shape>,
+                                   TopTools_ShapeMapHasher>
+  EdgeFaceMap;
+
+double volumeOf(const TopoDS_Shape& theShape)
+{
+  GProp_GProps aProps;
+  BRepGProp::VolumeProperties(theShape, aProps);
+  return aProps.Mass();
+}
+
+//! True if the shape is one valid solid whose every edge borders two faces.
+bool isClosedValidSolid(const TopoDS_Shape& theShape)
+{
+  if (theShape.IsNull())
+  {
+    return false;
+  }
+  int aNbSolids = 0;
+  for (TopExp_Explorer anExp(theShape, TopAbs_SOLID); anExp.More(); anExp.Next())
+  {
+    ++aNbSolids;
+  }
+  if (aNbSolids != 1 || !BRepCheck_Analyzer(theShape).IsValid())
+  {
+    return false;
+  }
+  EdgeFaceMap anEdgeFaces;
+  TopExp::MapShapesAndAncestors(theShape, TopAbs_EDGE, TopAbs_FACE, anEdgeFaces);
+  for (int anIdx = 1; anIdx <= anEdgeFaces.Extent(); ++anIdx)
+  {
+    if (!BRep_Tool::Degenerated(TopoDS::Edge(anEdgeFaces.FindKey(anIdx)))
+        && anEdgeFaces.FindFromIndex(anIdx).Extent() != 2)
+    {
+      return false;
+    }
+  }
+  return true;
+}
+
+//! The most contours the fallback intersects: each costs a fillet and a Boolean operation.
+const int THE_MAX_CONTOURS = 8;
+
+//! The fillets of the contours of theBuilder, computed after Compute() failed: each contour on its
+//! own, and the intersection of the results. Two fillets whose arcs cross are built this way.
+//! The contours must share no vertex, and every contour must be a constant radius.
+//! Null if not applicable.
+TopoDS_Shape fallbackFillets(ChFi3d_FilBuilder& theBuilder, const ChFi3d_FilletShape theShape)
+{
+  const int aNbContours = theBuilder.NbElements();
+  if (aNbContours < 1 || aNbContours > THE_MAX_CONTOURS)
+  {
+    return TopoDS_Shape();
+  }
+  const TopoDS_Shape&                                           aShape = theBuilder.InitialShape();
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> aVertices;
+  for (int aContour = 1; aContour <= aNbContours; ++aContour)
+  {
+    const occ::handle<ChFiDS_Spine> aSpine = theBuilder.Value(aContour);
+    if (aSpine.IsNull() || aSpine->NbEdges() < 1 || !theBuilder.IsConstant(aContour))
+    {
+      return TopoDS_Shape();
+    }
+    NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> aOwn;
+    for (int anEdge = 1; anEdge <= aSpine->NbEdges(); ++anEdge)
+    {
+      TopExp::MapShapes(aSpine->Edges(anEdge), TopAbs_VERTEX, aOwn);
+    }
+    for (int aVertex = 1; aVertex <= aOwn.Extent(); ++aVertex)
+    {
+      if (aVertices.Contains(aOwn(aVertex)))
+      {
+        return TopoDS_Shape();
+      }
+    }
+    for (int aVertex = 1; aVertex <= aOwn.Extent(); ++aVertex)
+    {
+      aVertices.Add(aOwn(aVertex));
+    }
+  }
+
+  const double aVolume = volumeOf(aShape);
+  TopoDS_Shape aResult;
+  double       aSumRemoved = 0., aMaxRemoved = 0.;
+  for (int aContour = 1; aContour <= aNbContours; ++aContour)
+  {
+    const TopoDS_Edge& aFirst  = theBuilder.Value(aContour)->Edges(1);
+    const double       aRadius = theBuilder.Radius(aContour);
+    TopoDS_Shape       aOne;
+    if (aNbContours > 1)
+    {
+      BRepFilletAPI_MakeFillet aSingle(aShape, theShape);
+      aSingle.Add(aRadius, aFirst);
+      aSingle.Build();
+      if (aSingle.IsDone() && isClosedValidSolid(aSingle.Shape()))
+      {
+        aOne = aSingle.Shape();
+      }
+    }
+    if (aOne.IsNull())
+    {
+      return TopoDS_Shape();
+    }
+    const double aRemoved = aVolume - volumeOf(aOne);
+    if (aRemoved <= 0.)
+    {
+      // Only fillets that take material away are an intersection.
+      return TopoDS_Shape();
+    }
+    aSumRemoved += aRemoved;
+    aMaxRemoved = std::max(aMaxRemoved, aRemoved);
+    if (aResult.IsNull())
+    {
+      aResult = aOne;
+      continue;
+    }
+    BRepAlgoAPI_Common aCommon(aResult, aOne);
+    if (!aCommon.IsDone() || aCommon.HasErrors() || !isClosedValidSolid(aCommon.Shape()))
+    {
+      return TopoDS_Shape();
+    }
+    aResult = aCommon.Shape();
+  }
+  // What the intersection removes is at least what any one fillet removes and at most the sum.
+  const double aTol     = 1.e-6 * aVolume;
+  const double aRemoved = aVolume - volumeOf(aResult);
+  if (aRemoved < aMaxRemoved - aTol || aRemoved > aSumRemoved + aTol)
+  {
+    return TopoDS_Shape();
+  }
+  return aResult;
+}
+} // namespace
 
 //=================================================================================================
 
@@ -371,7 +521,31 @@ occ::handle<TopOpeBRepBuild_HBuilder> BRepFilletAPI_MakeFillet::Builder() const
 void BRepFilletAPI_MakeFillet::Build(const Message_ProgressRange& /*theRange*/)
 {
   myBuilder.Compute();
-  if (myBuilder.IsDone())
+  if (!myBuilder.IsDone())
+  {
+    // Fillets that cross each other: see fallbackFillets.
+    TopoDS_Shape aFallback;
+    try
+    {
+      aFallback = fallbackFillets(myBuilder, myBuilder.GetFilletShape());
+    }
+    catch (Standard_Failure const&)
+    {
+    }
+    if (!aFallback.IsNull())
+    {
+      // The failed computation holds nothing of this result: clear its faulty contours.
+      myBuilder.Reset();
+      Done();
+      myShape = aFallback;
+      myMap.Clear();
+      for (TopExp_Explorer anExp(myShape, TopAbs_FACE); anExp.More(); anExp.Next())
+      {
+        myMap.Add(anExp.Current());
+      }
+    }
+  }
+  else
   {
     Done();
     myShape = myBuilder.Shape();
diff --git a/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder.hxx b/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder.hxx
index ab5614b1a..cac84b8b2 100644
--- a/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder.hxx
+++ b/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder.hxx
@@ -176,6 +176,9 @@ public:
   //! in the state of the last acquisition to enable modification of contours or areas.
   Standard_EXPORT void Reset();
 
+  //! Returns the shape on which the fillets are computed.
+  const TopoDS_Shape& InitialShape() const { return myShape; }
+
   //! Returns the Builder of topologic operations.
   Standard_EXPORT occ::handle<TopOpeBRepBuild_HBuilder> Builder() const;
 
diff --git a/src/ModelingAlgorithms/TKFillet/GTests/BRepFilletAPI_MakeFillet_OppositeEdges_Test.cxx b/src/ModelingAlgorithms/TKFillet/GTests/BRepFilletAPI_MakeFillet_OppositeEdges_Test.cxx
index 101669d54..d5a4d0007 100644
--- a/src/ModelingAlgorithms/TKFillet/GTests/BRepFilletAPI_MakeFillet_OppositeEdges_Test.cxx
+++ b/src/ModelingAlgorithms/TKFillet/GTests/BRepFilletAPI_MakeFillet_OppositeEdges_Test.cxx
@@ -106,3 +106,47 @@ TEST(BRepFilletAPI_MakeFilletTest, OCCT1568_OppositeFilletsThatTouchAreValid)
   const double aRemoved = (1.0 - M_PI / 4.0) * (1.5 * 1.5 + 2.5 * 2.5) * 10.0;
   EXPECT_NEAR(volumeOf(aFillet.Shape()), 240.0 - aRemoved, 1.e-6);
 }
+
+// The arcs cross on the face between: the result is the intersection of the two rounded profiles.
+// Removed area 3.749792368679 for r = 3,
+// 2 w r - pi r^2 / 2 + (r - w / 2) sqrt(w r - w^2 / 4) + r^2 asin(1 - w / (2 r)) with w = 4.
+TEST(BRepFilletAPI_MakeFilletTest, OCCT1568_OppositeFilletsWhoseArcsCrossAreTheIntersection)
+{
+  const TopoDS_Shape       aBox = BRepPrimAPI_MakeBox(4.0, 10.0, 6.0).Shape();
+  BRepFilletAPI_MakeFillet aFillet(aBox);
+  aFillet.Add(3.0, findEdgeAt(aBox, gp_Pnt(0.0, 5.0, 6.0)));
+  aFillet.Add(3.0, findEdgeAt(aBox, gp_Pnt(4.0, 5.0, 6.0)));
+  ASSERT_NO_THROW(aFillet.Build());
+  ASSERT_TRUE(aFillet.IsDone());
+  EXPECT_TRUE(BRepCheck_Analyzer(aFillet.Shape()).IsValid());
+  EXPECT_NEAR(volumeOf(aFillet.Shape()), 240.0 - 10.0 * 3.749792368679, 1.e-6);
+}
+
+// r1 = 1, r2 = 3.5: removed area 2.840940340.
+TEST(BRepFilletAPI_MakeFilletTest, OCCT1568_OppositeFilletsOfDifferentRadiiCross)
+{
+  const TopoDS_Shape       aBox = BRepPrimAPI_MakeBox(4.0, 10.0, 6.0).Shape();
+  BRepFilletAPI_MakeFillet aFillet(aBox);
+  aFillet.Add(1.0, findEdgeAt(aBox, gp_Pnt(0.0, 5.0, 6.0)));
+  aFillet.Add(3.5, findEdgeAt(aBox, gp_Pnt(4.0, 5.0, 6.0)));
+  ASSERT_NO_THROW(aFillet.Build());
+  ASSERT_TRUE(aFillet.IsDone());
+  EXPECT_TRUE(BRepCheck_Analyzer(aFillet.Shape()).IsValid());
+  EXPECT_NEAR(volumeOf(aFillet.Shape()), 240.0 - 10.0 * 2.840940340, 1.e-6);
+}
+
+// The radii exceed the half width by less than the tolerance: the arcs meet within it and the
+// result is the solid of two arcs that touch, to within the tolerance.
+TEST(BRepFilletAPI_MakeFilletTest, OCCT1568_OppositeFilletsMeetingWithinToleranceAreBuilt)
+{
+  const TopoDS_Shape       aBox = BRepPrimAPI_MakeBox(4.0, 10.0, 6.0).Shape();
+  BRepFilletAPI_MakeFillet aFillet(aBox);
+  aFillet.Add(2.0 + 1.e-9, findEdgeAt(aBox, gp_Pnt(0.0, 5.0, 6.0)));
+  aFillet.Add(2.0 + 1.e-9, findEdgeAt(aBox, gp_Pnt(4.0, 5.0, 6.0)));
+  ASSERT_NO_THROW(aFillet.Build());
+  ASSERT_TRUE(aFillet.IsDone());
+  EXPECT_TRUE(BRepCheck_Analyzer(aFillet.Shape()).IsValid());
+  EXPECT_NEAR(volumeOf(aFillet.Shape()),
+              240.0 - 10.0 * (4.0 - M_PI) / 4.0 * 2.0 * 2.0 * 2.0,
+              1.e-6);
+}
