-//! own, and the intersection of the results. Two fillets whose arcs cross are built this way.
-//! The contours must share no vertex, and every contour must be a constant radius.
-//! Null if not applicable.
+//! own (by the same builder, or by a pivot cut when that fails too), and the intersection of the
+//! results. Two fillets whose arcs cross, or that run out of face, are built this way. The contours
+//! must share no vertex, and every contour must be a constant radius. Null if not applicable.
 TopoDS_Shape fallbackFillets(ChFi3d_FilBuilder& theBuilder, const ChFi3d_FilletShape theShape)
 {
   const int aNbContours = theBuilder.NbElements();
@@ -142,6 +383,10 @@ TopoDS_Shape fallbackFillets(ChFi3d_FilBuilder& theBuilder, const ChFi3d_FilletS
         aOne = aSingle.Shape();
