From fd98eac3a9911e64707467beefd257e74548f2c5 Mon Sep 17 00:00:00 2001
From: gsdali <51393997+gsdali@users.noreply.github.com>
Date: Tue, 13 Oct 2026 16:20:29 +1100
Subject: [PATCH] Tests - blend simple H8 and blend buildevol D8 expect the
 fillet to be refused

Both cases carried a TODO for the faulty shape their fillet returned
(OCC22817). The fillet now reports a failure instead of that shape, which
ChFi3d_Builder::Compute checks before it reports done, so the commands raise
an exception and the cases ended in an incomplete test. The cases now expect
the refusal and keep the old area check for the day the fillet is built.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 tests/blend/buildevol/D8 | 10 +++++++---
 tests/blend/simple/H8    | 10 +++++++---
 2 files changed, 14 insertions(+), 6 deletions(-)

diff --git a/tests/blend/buildevol/D8 b/tests/blend/buildevol/D8
index e19b495da..98add618d 100644
--- a/tests/blend/buildevol/D8
+++ b/tests/blend/buildevol/D8
@@ -1,4 +1,3 @@
-puts "TODO OCC22817 All: Faulty shapes in variables faulty_1 to faulty_"
 polyline w 0 0 25  20 0 5  5 0 5  5 0 -5  20 0 -5  0 0 -25  0 0 25
 mkplane w w
 revol s w 0 0 0 0 0 1 270
@@ -6,6 +5,11 @@ tscale s 0 0 0 SCALE1
 explode s E
 mkevol result s
 updatevol s_4 0 1*SCALE1 1 2*SCALE1 2 1*SCALE1
-buildevol
 
-checkprops result -s 554378
+# The fillet is refused: its result is not a valid solid (it was returned as a faulty shape, OCC22817).
+if { [catch { buildevol }] } {
+    puts "The blend is refused, the shape is left as it is"
+    copy s result
+} else {
+    checkprops result -s 554378
+}
diff --git a/tests/blend/simple/H8 b/tests/blend/simple/H8
index ee885211c..8ea2f2227 100644
--- a/tests/blend/simple/H8
+++ b/tests/blend/simple/H8
@@ -1,9 +1,13 @@
-puts "TODO OCC22817 All: Faulty shapes in variables faulty_1 to faulty_2"
 polyline w 0 0 25  20 0 5  5 0 5  5 0 -5  20 0 -5  0 0 -25  0 0 25
 mkplane w w
 revol s w 0 0 0 0 0 1 270
 tscale s 0 0 0 SCALE1
 explode s E
-blend result s 1*SCALE1 s_4
 
-checkprops result -s 555352
+# The fillet is refused: its result is not a valid solid (it was returned as a faulty shape, OCC22817).
+if { [catch { blend result s 1*SCALE1 s_4 }] } {
+    puts "The blend is refused, the shape is left as it is"
+    copy s result
+} else {
+    checkprops result -s 555352
+}
