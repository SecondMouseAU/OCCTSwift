+//=================================================================================================
+// Thread-safety tests (issue #1153)
+//=================================================================================================
+
+// A single-threaded call into any derivative-family method (D1/D2/D3, and their *Local
+// counterparts, and the protected calculateDerivative/calculateDerivativeLocal) is enough to
+// prove the internal locking does not nest incorrectly: D1() locks myMutex and calls D1Local(),
+// which is itself a public entry point and also locks myMutex. Under the original PR's
+// non-recursive std::mutex this hangs forever on the very first call, single-threaded, no
+// concurrency needed to observe it (confirmed separately in
+// Scripts/repro/1153-bspline-adaptor-cache/deadlock_before.txt via an external-timeout probe,
+// since GTest itself has no built-in per-case timeout and a genuinely deadlocked thread does not
+// respond to it). This case is the GTest-side half of that same proof: it simply calls D1/D2/D3
+// and checks the results, so it passes promptly against the fix and hangs the whole binary
+// against the original broken patch.
+TEST_F(BSplCLib_CacheTest, DerivativeMethodsDoNotDeadlock)
+{
+  NCollection_Array1<gp_Pnt> aPoles(1, 4);
+  aPoles(1) = gp_Pnt(0, 0, 0);
+  aPoles(2) = gp_Pnt(1, 2, 1);
+  aPoles(3) = gp_Pnt(2, 2, 1);
+  aPoles(4) = gp_Pnt(3, 0, 0);
+
+  NCollection_Array1<double> aKnots(1, 2);
+  aKnots(1) = 0.0;
+  aKnots(2) = 1.0;
+
+  NCollection_Array1<int> aMults(1, 2);
+  aMults(1) = 4;
+  aMults(2) = 4;
+
+  NCollection_Array1<double> aFlatKnots(1, 8);
+  createFlatKnots(aKnots, aMults, aFlatKnots);
+
+  const int aDegree = 3;
+
+  occ::handle<BSplCLib_Cache> aCache =
+    new BSplCLib_Cache(aDegree, false, aFlatKnots, aPoles, nullptr);
+  aCache->BuildCache(0.5, aFlatKnots, aPoles, nullptr);
+
+  gp_Pnt aPoint;
+  gp_Vec aTangent, aCurvature, aTorsion;
+  aCache->D1(0.5, aPoint, aTangent);
+  EXPECT_TRUE(std::isfinite(aPoint.X()));
+  aCache->D2(0.5, aPoint, aTangent, aCurvature);
+  EXPECT_TRUE(std::isfinite(aCurvature.X()));
+  aCache->D3(0.5, aPoint, aTangent, aCurvature, aTorsion);
+  EXPECT_TRUE(std::isfinite(aTorsion.X()));
+}
+
+// Concurrent variant: N threads share ONE cache and each iteration re-runs BuildCache() (a
+// genuine concurrent WRITE to myParams/myPolesWeightsBuffer, exactly what
+// GeomAdaptor_Curve::RebuildCache does when a shared adaptor's cache goes stale) immediately
+// followed by D0/D1/D2/D3 (cycling per iteration, so every derivative-family method's internal
+// locking is exercised, not just D0). Plain concurrent READS of an already-built, never-rebuilt
+// cache are not a data race at all, which is why this test rebuilds every iteration rather than
+// building once: without that, the first version of this test passed against unpatched
+// (unlocked) code too, proving nothing. With the rebuild, unsynchronized (stock) code visibly
+// disagrees with the single-threaded reference computed via the same BuildCache+D1 sequence; the
+// mutex added for #1153 must make every concurrent read agree with it.
+TEST_F(BSplCLib_CacheTest, ConcurrentRebuildAndEvaluationMatchesReference)
+{
+  NCollection_Array1<gp_Pnt> aPoles(1, 4);
+  aPoles(1) = gp_Pnt(0, 0, 0);
+  aPoles(2) = gp_Pnt(1, 2, 1);
+  aPoles(3) = gp_Pnt(2, 2, 1);
+  aPoles(4) = gp_Pnt(3, 0, 0);
+
+  NCollection_Array1<double> aKnots(1, 2);
+  aKnots(1) = 0.0;
+  aKnots(2) = 1.0;
+
+  NCollection_Array1<int> aMults(1, 2);
+  aMults(1) = 4;
+  aMults(2) = 4;
+
+  NCollection_Array1<double> aFlatKnots(1, 8);
+  createFlatKnots(aKnots, aMults, aFlatKnots);
+
+  const int    aDegree = 3;
+  const double aParam  = 0.5;
+
+  occ::handle<BSplCLib_Cache> aCache =
+    new BSplCLib_Cache(aDegree, false, aFlatKnots, aPoles, nullptr);
+  aCache->BuildCache(aParam, aFlatKnots, aPoles, nullptr);
+
+  gp_Pnt aRefPoint;
+  gp_Vec aRefTangent;
+  aCache->D1(aParam, aRefPoint, aRefTangent);
+
+  const int                aThreadCount = 16;
+  const int                anIterations = 3000;
+  std::atomic<long>        aMismatches{0};
+  std::vector<std::thread> aPool;
+  for (int t = 0; t < aThreadCount; ++t)
+  {
+    aPool.emplace_back([&]() {
+      for (int it = 0; it < anIterations; ++it)
+      {
+        aCache->BuildCache(aParam, aFlatKnots, aPoles, nullptr);
+
+        gp_Pnt aPoint;
+        gp_Vec aTangent, aCurvature, aTorsion;
+        switch (it % 4)
+        {
+          case 0:
+            aCache->D0(aParam, aPoint);
+            break;
+          case 1:
+            aCache->D1(aParam, aPoint, aTangent);
+            break;
+          case 2:
+            aCache->D2(aParam, aPoint, aTangent, aCurvature);
+            break;
+          default:
+            aCache->D3(aParam, aPoint, aTangent, aCurvature, aTorsion);
+            break;
+        }
+        if (!std::isfinite(aPoint.X()) || (aPoint.Distance(aRefPoint) > THE_TOLERANCE))
+        {
+          aMismatches++;
+        }
+      }
+    });
+  }
+  for (auto& t : aPool)
+  {
+    t.join();
+  }
+  EXPECT_EQ(aMismatches.load(), 0)
+    << "concurrent BuildCache+D0-D3 on one shared cache disagreed with the single-threaded "
+       "reference "
+    << aMismatches.load() << " times out of " << (aThreadCount * anIterations);
+}
