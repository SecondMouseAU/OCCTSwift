  {
    "test_name": "Feature Recognition, AAG::boxAAG",
    "bridge_function": "OCCTFaceGetSharedEdgeSummary",
    "bridge_output": {
      "type": "value",
      "data": {
        "faces": 6,
        "adjacentPairs": 12
      }
    },
    "kernel_output": {
      "type": "value",
      "data": {
        "faces": 6,
        "adjacentPairs": 12
      }
    },
    "comparison": {
      "equal": true,
      "differences": []
    },
    "status": "PASS",
    "source": "Same quantity on both sides: face count and adjacent-face-pair count of the 10 mm box. Bridge: AAG.nodes.count (one node per face occurrence) and AAG.edges.count (one graph edge per face pair that OCCTFaceGetSharedEdgeSummary reports sharing an edge); the test observed 6 and 12. Kernel: TopExp_Explorer over the box faces, a pair counted when the two faces' TopExp::MapShapes edge maps share an edge by IsSame; boxAAG line of the transcript printed faces=6 adjacentPairs=12.",
    "probe": "Scripts/repro/766-modeling-aag/probe-evidence-fix.mm (transcript-evidence-fix.txt)"
  },
