  {
    "test_name": "ShapeBuild Edge::copyEdge",
    "bridge_function": "OCCTShapeBuildEdge*",
    "bridge_output": {
      "type": "edge",
      "data": "as asserted"
    },
    "kernel_output": {
      "type": "edge",
      "data": {
        "edge0": {
          "from": [
            -5,
            -5,
            -5
          ],
          "to": [
            -5,
            -5,
            5
          ],
          "range": [
            0,
            10
          ]
        },
        "copy": {
          "isSame": false,
          "range": [
            0,
            10
          ]
        },
        "replaceVertices": {
          "from": [
            -5,
            -5,
            5
          ],
          "to": [
            -5,
            -5,
            -5
          ]
        },
        "setRange3d": [
          0,
          5
        ],
        "copyRangesBack": [
          0,
          10
        ],
        "BuildCurve3d": true,
        "removeCurve3d": {
          "hasCurve3d": false
        },
        "cylinderRemovePCurve": {
          "hasPCurve": false
        },
        "cylinderCopyPCurves": {
          "hasPCurve": true
        }
      }
    },
    "comparison": {
      "equal": true,
      "differences": []
    },
    "status": "PASS"
  },
