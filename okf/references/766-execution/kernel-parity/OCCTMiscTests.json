    "test_name": "Bridge exception diagnostics (#1161)::a caught Standard_Failure reaches Swift with OCCT's own type name and message",
    "test_file": "Tests/OCCTMiscTests/BridgeExceptionDiagnosticsTests.swift",
    "bridge_function": "OCCTIntToolsIsDirsCoinside",
    "bridge_output": {
      "type": "diagnostic_record",
