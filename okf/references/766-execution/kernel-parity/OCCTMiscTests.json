        "value": false,
        "count": 1,
        "kind": "occtFailure",
        "exceptionType": "Standard_ConstructionError",
        "messageContains": "zero norm",
        "function": "OCCTIntToolsIsDirsCoinside",
        "stackTraceEmpty": true
      }
    },
    "kernel_output": {
      "type": "caught_exception",
      "data": {
        "exceptionType": "Standard_ConstructionError",
        "message": "gp_Dir() - input vector has zero norm",
        "stackTraceEmpty": true
      }
    },
    "comparison": {
      "equal": true,
      "differences": []
    },
    "status": "PASS"
  },
