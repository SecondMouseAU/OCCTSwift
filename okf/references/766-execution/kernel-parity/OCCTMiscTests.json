  {
    "test_name": "Bridge exception diagnostics (#1161)::a negative stack-trace depth is clamped rather than passed through",
    "test_file": "Tests/OCCTMiscTests/BridgeExceptionDiagnosticsTests.swift",
    "bridge_function": "OCCTDiagnosticsSetStackTraceDepth",
    "bridge_output": {
      "type": "int",
      "data": {
        "set": -5,
        "read": 0
      }
    },
    "kernel_output": {
      "type": "int",
      "data": {
        "SetDefaultStackTraceLength(-5)": -5
      }
    },
    "comparison": {
      "equal": false,
      "differences": [
        "Expected divergence, and the reason the clamp exists: the kernel stores -5 as given (DefaultStackTraceLength() reads back -5), the bridge and the Swift setter each clamp it to 0."
      ]
    },
    "status": "EXPECTED_DIVERGENCE"
  },
