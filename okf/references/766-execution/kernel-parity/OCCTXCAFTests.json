      "type": "dimension",
      "data": {
        "before": [
          20,
          -0.3,
          0.7
        ],
        "after_unguarded_write": {
          "value": 10,
          "lowerTol": 12,
          "upperTol": 0.7,
          "plusMinus": true
        }
      }
    },
    "comparison": {
      "equal": true,
