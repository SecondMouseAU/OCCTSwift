    "test_name": "TDataStd_Directory Tests::addSubDirectory",
    "bridge_function": "OCCTDocumentDirectoryAddSubDirectory",
    "bridge_output": {
      "type": "label",
      "data": {
        "tag_non_nil": true
      }
    },
    "kernel_output": {
      "type": "label",
      "data": {
        "tag_non_nil": true
      }
    },
    "comparison": {
      "equal": true,
      "differences": []
    },
    "status": "PASS",
    "source": "Same quantity on both sides: tag_non_nil. Bridge: OCCTDocumentDirectoryAddSubDirectory returns subDir->Label().Tag() or -1, and Document.addSubDirectory maps tag >= 0 to non-nil; the test observed non-nil. Kernel: TDataStd_Directory::AddDirectory returned a non-null directory on label tag 1, and 1 >= 0 gives tag_non_nil true. The bridge's raw tag was not printed, so raw tags are not compared.",
    "probe": "Scripts/repro/766-xcaf-directory/"
  },
