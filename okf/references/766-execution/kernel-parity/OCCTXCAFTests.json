  {
    "test_name": "TDataStd_Current Tests::noCurrentReturnsNil",
    "bridge_function": "OCCTDocumentGetCurrentLabel",
    "bridge_output": {
      "type": "bool",
      "data": {
        "has_current": false
      }
    },
    "kernel_output": {
      "type": "bool",
      "data": {
        "has_current": false
      }
    },
    "comparison": {
      "equal": true,
      "differences": []
    },
    "status": "PASS",
    "source": "Same quantity on both sides: has_current. Bridge: OCCTDocumentGetCurrentLabel returns -1 exactly when TDataStd_Current::Has(Main) is false, and Document.currentLabel() maps -1 to nil; the test observed nil, so has_current is false. Kernel: TDataStd_Current::Has(Main) printed false on a fresh document.",
    "probe": "Scripts/repro/766-xcaf-current/"
  },
