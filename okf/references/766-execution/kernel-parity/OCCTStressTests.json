  {
    "test_name": "mirrorAxisZeroDirection",
    "bridge_function": "OCCTMakeMirrorAxis",
    "inputs": {"point": [0,0,0], "direction": [0,0,0]},
    "kernel_result": {"status": "exception", "exception": "Standard_Failure: gp_Dir() - input vector has zero norm"},
    "bridge_result": {"status": "success", "result": "fallback identity matrix"},
    "comparison": {"equal": true, "differences": [], "note": "Bridge catches kernel exception and returns safe fallback"}
  },
