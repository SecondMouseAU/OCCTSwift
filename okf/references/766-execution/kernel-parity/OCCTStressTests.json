  {
    "test_name": "edgePairedWithUnrelatedCylindricalFaceDoesNotCrash",
    "bridge_function": "OCCTBRepToolsEvalAndUpdateTol",
    "inputs": {"edge": "box edge", "face": "cylinder lateral face"},
    "kernel_result": {"status": "success", "c2d": "null", "note": "BRep_Tool::CurveOnSurface returns null for non-planar unrelated face"},
    "bridge_result": {"status": "success", "result": "edge tolerance returned", "note": "Bridge guards null pcurve and returns edge tolerance"},
    "comparison": {"equal": true, "differences": [], "note": "Bridge correctly handles kernel's null pcurve behavior"}
  },
  {
    "test_name": "edgePairedWithAnUnrelatedPlanarFaceDoesNotCrash",
    "bridge_function": "OCCTBRepToolsEvalAndUpdateTol",
    "inputs": {"edge": "box edge", "face": "unrelated box face"},
    "kernel_result": {"status": "success", "c2d": "projected pcurve (non-null)", "note": "BRep_Tool::CurveOnSurface projects 3D curve onto plane"},
    "bridge_result": {"status": "success", "result": "updated tolerance from BRepTools::EvalAndUpdateTol", "note": "Bridge calls EvalAndUpdateTol with projected pcurve"},
    "comparison": {"equal": true, "differences": [], "note": "Bridge correctly passes projected pcurve to kernel"}
  },
